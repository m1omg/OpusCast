#!/usr/bin/env python3
"""opuscast - play videos, music and photos from this PC on your TV, or show it the desktop
(command-line OpusCast).

  opuscast VIDEO                  play it on the TV (Ctrl+C stops)
  opuscast VIDEO --from 1:02:30   start part-way through
  opuscast VIDEO --sub auto       with subtitles (auto, a file, or a track number from --subs)
  opuscast VIDEO --subs           list the subtitles found for the video
  opuscast VIDEO --intro          Skynet boot intro first
  opuscast SONG... | FOLDER       play songs one after another
  opuscast PHOTO... --every 8     slideshow, a new photo every 8 seconds (one photo stays up)
  opuscast --desktop              show this PC's screen and sound on the TV (--size 720, --fps 60,
                                  --screen 2, --no-sound, --bring-back); if the TV leaves it, it's
                                  still shared: OpusCast is among the TV's sources, or press Enter
  opuscast --list                 show devices on the network and which can play video
  opuscast --stop                 stop whatever the TV is playing
"""
import argparse
import os
import sys
import threading
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import opuscast_core as core  # noqa: E402
import opuscast_media as media  # noqa: E402
from opuscast_i18n import _  # noqa: E402


def states():
    return {"PLAYING": _("playing"), "PAUSED_PLAYBACK": _("paused"), "STOPPED": _("stopped"),
            "TRANSITIONING": _("loading"), "NO_MEDIA_PRESENT": _("idle"), "UNREACHABLE": _("not responding")}


def start(tv, server, path, start_at=0, subtitle=None, media_obj=None):
    """Publish and start a video (or start already published media). If the start commands fail, the
    TV may still play it (a Samsung asks "Allow this device?" the first time and carries the commands
    out once allowed): say so and go on."""
    item = media_obj or server.publish(os.path.abspath(path), subtitle)
    try:
        item["captions"] = core.play_media(tv, server, item, start_at, subs_on=subtitle is not None)
        item["start_error"] = None
    except core.TVError as e:
        item["start_error"] = e
        print(_("The TV hasn't taken it yet ({error}). If the TV asks whether to allow this PC, choose Allow - "
                "it then starts by itself.").format(error=e))
    item["start_at"], item["subtitle"] = start_at, subtitle
    return item


def wait_until_done(tv, server, item, quiet=False):
    """Follow the TV until it's done. Returns None if it never started, else True when it played to
    the end and False when it was stopped half-way (or something else is on the TV now)."""
    seen, last, start_time, warned = False, None, time.time(), False
    answering, retried, pos, dur = None, False, 0, 0
    names = states()
    while True:
        time.sleep(1)
        if item.get("start_error") is not None and not seen and time.time() - start_time > 120:
            print(_("Couldn't start it on the TV: {error}").format(error=item["start_error"]))
            return None
        if item["live"] is not None and item["live"].closed:
            return False  # the desktop capture stopped
        if (not item["requested"].is_set() and not warned and time.time() - start_time > 15
                and item.get("start_error") is None):
            warned = True
            print(_("The TV hasn't loaded the video yet - a firewall on this PC may be blocking it.") + "\n"
                  f"  ufw:       sudo ufw allow from {tv.host} to any port {server.port} proto tcp\n"
                  f"  firewalld: sudo firewall-cmd --permanent --add-rich-rule='rule family=ipv4 "
                  f"source address={tv.host} port port={server.port} protocol=tcp accept' && sudo firewall-cmd --reload")
        try:
            state = tv.state()
            now_pos, now_dur, uri = tv.position()
            answering = answering or time.time()
        except core.TVError:
            state, uri, answering, now_pos, now_dur = "UNREACHABLE", None, None, None, None
        ours = not uri or item["url_path"] in uri
        if ours and state == "PLAYING":
            pos, dur = now_pos if now_pos is not None else pos, now_dur or dur
        if item.get("start_error") is not None and not seen and not retried and answering \
                and time.time() - answering >= 4 and not (state == "PLAYING" and ours):
            retried = True  # the TV answers again but didn't start it by itself: send it once more
            try:
                item["captions"] = core.play_media(tv, server, item, item["start_at"],
                                                    subs_on=item["subtitle"] is not None)
            except core.TVError:
                pass
        if state != last and not quiet:
            print(_("TV:"), names.get(state, state.lower()))
        last = state
        if item["live"] is not None:
            if core.showing_live(item, state, uri):
                return True  # the live picture is on the TV: the caller follows it from here
            continue
        if state == "PLAYING" and ours:
            if not seen and item.get("start_error") is not None and item["start_at"] > 1:
                try:  # the resume point was never sent
                    tv.seek(item["start_at"])
                except core.TVError:
                    pass
            seen = True
        elif seen and item["kind"] != "image" and (state in ("STOPPED", "NO_MEDIA_PRESENT") or not ours):
            length = dur or item["meta"].get("duration") or 0
            return ours and (not length or pos >= length - 5)
        elif seen and item["kind"] == "image":
            return True  # shown: the slideshow decides how long


def parse_start(text):
    if text is None:
        return 0
    if text.isdigit():
        return int(text)
    t = core.parse_time(text)
    if t is None:
        sys.exit(_("Can't read the time {time!r} - use e.g. 1:02:30, 45:00 or 300").format(time=text))
    return t


def list_devices():
    print(_("Scanning the network..."))
    for d in core.scan_network():
        mark = "✓" if d["can_play"] else "✗"
        detail = f" ({d['detail']})" if d["detail"] else ""
        print(f" {mark} {d['ip']:15} {d['name']}{detail}\n{'':19}{d['note']}")


def pick_subtitle(video, choice):
    entries = core.list_subtitles(video)
    if choice == "auto":
        entry = core.auto_subtitle(entries)
        if not entry:
            print(_("No usable subtitles found - playing without."))
        return entry
    if choice.isdigit():
        n = int(choice)
        if 1 <= n <= len(entries):
            entry = entries[n - 1]
            if not entry["ok"]:
                sys.exit(f"{entry['label']}: {entry['why']}")
            return entry
        sys.exit(_("There's no subtitle number {n} - see opuscast VIDEO --subs").format(n=n))
    if os.path.isfile(choice):
        return core.subtitle_file_entry(os.path.abspath(choice))
    sys.exit(_("No such subtitle file: {path}").format(path=choice))


def play_songs(tv, server, songs):
    """One after another; stops when a song is stopped half-way on the TV."""
    for n, path in enumerate(songs, 1):
        tags = media.audio_tags(path)
        play, mime = path, None
        if media.needs_mp3(tv, core.mime_of(path, "audio")):
            print(_("Converting {name} to MP3 - the TV doesn't play this format…").format(name=os.path.basename(path)))
            try:
                play, mime = media.to_mp3(path), "audio/mpeg"
            except core.TVError as e:
                print(_("Can't play {name}: {error}").format(name=os.path.basename(path), error=e))
                continue
        meta = {k: tags[k] for k in ("artist", "albumartist", "album", "track", "duration") if tags.get(k)}
        song = server.publish(play, kind="audio", mime=mime, title=tags.get("title"), meta=meta)
        cover = media.song_cover(path, tags)
        if cover:
            song["meta"]["cover_path"], song["meta"]["cover_mime"] = server.add_extra(song, *cover), cover[0]
        start(tv, server, play, media_obj=song)
        line = " · ".join(x for x in (song["title"], media.song_line(tags)) if x)
        print(f"[{n}/{len(songs)}] {line}")
        result = wait_until_done(tv, server, song, quiet=True)
        if result is None:
            return False
        if result is False:
            print(_("Stopped on the TV."))
            return True
    return True


def show_photos(tv, server, photos, every):
    """A slideshow, round and round; one photo just stays on the TV."""
    n = 0
    while True:
        path = photos[n % len(photos)]
        try:
            prep = media.prepare_photo(path, tv)
        except OSError as e:
            print(_("Can't read that photo: {error}").format(error=e))
            if len(photos) == 1:
                return False
            n += 1
            continue
        photo = server.publish(path, kind="image", data=prep.get("data"), mime=prep["mime"],
                               features=prep["features"])
        start(tv, server, path, media_obj=photo)
        print(f"[{n % len(photos) + 1}/{len(photos)}] {os.path.basename(path)}")
        if prep.get("unconverted"):
            print("  " + _("The TV may not show {name}: this PC can't convert this kind of photo. "
                           "This helps:").format(name=os.path.basename(path)) + " " + core.install_hint(["photos"]))
        if len(photos) == 1:
            print(_("(Ctrl+C takes it off the TV)"))
            while True:
                time.sleep(3600)
        time.sleep(every)
        n += 1


def cast_desktop(tv, server, cfg, a):
    import opuscast_desktop as desk
    need = desk.missing()
    if need:
        sys.exit(_("Casting the desktop needs a little more software. Install it with:") + "\n  "
                 + core.install_hint(need))
    area = None
    if desk.session_kind() == "x11":
        screens = desk.x11_screens()
        if a.screen and not 1 <= a.screen <= len(screens):
            sys.exit(_("There's no screen {n} - this PC has {count}.").format(n=a.screen, count=len(screens) or 1))
        pick = screens[a.screen - 1] if a.screen else next((x for x in screens if x[5]), None)
        if pick:
            area = pick[1:5]
    cast = desk.DesktopCast(height=a.size, fps=a.fps, sound=not a.no_sound, area=area,
                            restore_token=cfg.get("portal_token"))
    loop = None
    if desk.session_kind() == "wayland":  # the screen-cast portal answers through a GLib main loop
        from gi.repository import GLib
        loop = GLib.MainLoop()
        threading.Thread(target=loop.run, daemon=True).start()
        print(_("Choose what to show in the window that opens…"))
    ended = threading.Event()
    cast.on_end = lambda msg: (print("\n" + _("Desktop casting stopped: {error}").format(error=msg)), ended.set())
    ready, result = threading.Event(), []
    cast.start(lambda err: (result.append(err), ready.set()))
    ready.wait()
    if result[0]:
        sys.exit(_("Couldn't cast the desktop: {error}").format(error=result[0]))
    if cast.restore_token:
        cfg["portal_token"] = cast.restore_token
        core.save_config(cfg)
    source = None
    try:
        live = server.publish(live=cast.live, title=_("Desktop"))
        try:
            source = core.TVSource(server, tv.host, live)
        except OSError:
            pass  # no way back from the TV's own menu, the rest works
        start(tv, server, None, media_obj=live)
        print(_("Showing the desktop on {tv}: {how}").format(tv=tv.name, how=cast.describe()))
        if cast.want_sound and not cast.sound:
            print(_("The PC's sound isn't going to the TV: there's no sound server to record it from."))
        print(_("(keep this open - Ctrl+C stops)"))
        if source:
            print(_("Left it on the TV by mistake? Choose “{source}” in the TV's sources to go back, or press "
                    "Enter here.").format(source=source.name))
        if follow_desktop(tv, server, live, source, a.bring_back) is None:
            sys.exit(1)
    finally:
        if source:
            source.close()
        cast.stop()
        if loop:
            loop.quit()


def _enter_presses():
    """An event set each time Enter is pressed here (never, without a keyboard)."""
    pressed = threading.Event()

    def read():
        while True:
            try:
                line = sys.stdin.readline()
            except (OSError, ValueError):
                return
            if not line:
                return  # no keyboard (stdin closed or not a terminal)
            pressed.set()
    threading.Thread(target=read, daemon=True).start()
    return pressed


def follow_desktop(tv, server, media, source, bring_back=False):
    """Share until Ctrl+C. When the TV leaves the desktop (Back, another source...), it stays shared: the
    TV can come back by itself (OpusCast among its sources), Enter here shows it there again, and with
    bring_back it's sent again by itself once. Nobody watching for 30 minutes ends it. Returns None if
    the TV never showed it."""
    if wait_until_done(tv, server, media, quiet=True) is None:
        return None
    watch = core.ShareWatch(media, bring_back)
    watch.started()
    enter = _enter_presses()

    def send():
        try:
            core.play_media(tv, server, media)
            watch.sent()
        except core.TVError as e:
            watch.send_failed()
            print(_("The TV didn't accept that: {error}").format(error=e))
            print(_("The TV didn't show it again - is it on? Press Enter to try again."))

    while True:
        time.sleep(1)
        if media["live"].closed:
            return True  # the capture stopped (on_end says why)
        try:
            state = tv.state()
            uri = tv.position()[2]
        except core.TVError:
            state = uri = None
        if enter.is_set():
            enter.clear()
            if watch.away and watch.sent_at is None:  # (not while the TV is still taking it)
                print(_("Showing it on the TV again…"))
                send()
        event = watch.update(state, uri)
        if event == "left":
            if source:
                print(_("The TV left the desktop - it's still shared. To go back, choose “{source}” in the TV's "
                        "sources, or press Enter here (Ctrl+C stops).").format(source=source.name))
            else:
                print(_("The TV left the desktop - it's still shared. Press Enter to show it there again "
                        "(Ctrl+C stops)."))
        elif event == "back":
            print(_("Back on the TV."))
        elif event == "send":
            print(_("The TV left the desktop - showing it there again…"))
            send()
        elif event == "failed":
            print(_("The TV didn't show it again - is it on? Press Enter to try again."))
        elif event == "idle":
            print(_("Nobody watched the desktop for 30 minutes, so OpusCast stopped sharing it."))
            return True


def main():
    try:  # what it says should show up as it happens, also through a pipe or into a log
        sys.stdout.reconfigure(line_buffering=True)
    except (AttributeError, ValueError):
        pass
    ap = argparse.ArgumentParser(prog="opuscast", description=_("Play videos, music and photos from this PC on your "
                                                                "TV, or show it the desktop."))
    ap.add_argument("file", nargs="*", help=_("videos, songs, photos or a folder"))
    ap.add_argument("--tv", metavar="IP", help=_("TV address (default: the last TV used, or the first one found)"))
    ap.add_argument("--from", dest="start", metavar="TIME", help=_("start at TIME, e.g. 1:02:30"))
    ap.add_argument("--sub", metavar="WHICH", help=_("subtitles: auto, a subtitle file, or a number from --subs"))
    ap.add_argument("--subs", action="store_true", help=_("list the subtitles found for the video"))
    ap.add_argument("--intro", action="store_true", help=_("play the Skynet boot intro first"))
    ap.add_argument("--every", type=float, default=5, metavar="SECONDS", help=_("slideshow: seconds per photo"))
    ap.add_argument("--desktop", action="store_true", help=_("show this PC's screen and sound on the TV"))
    ap.add_argument("--size", type=int, choices=(720, 1080), default=1080, help=_("desktop: picture size"))
    ap.add_argument("--fps", type=int, choices=(30, 60), default=30, help=_("desktop: pictures a second"))
    ap.add_argument("--screen", type=int, metavar="N", help=_("desktop on X11: which screen (default: the main one)"))
    ap.add_argument("--no-sound", action="store_true", help=_("desktop: without the PC's sound"))
    ap.add_argument("--bring-back", action="store_true",
                    help=_("desktop: if the TV leaves it, show it there again by itself (leave it twice in a row "
                           "to stop)"))
    ap.add_argument("--list", action="store_true", help=_("show devices on the network and which can play video"))
    ap.add_argument("--stop", action="store_true", help=_("stop playback on the TV and exit"))
    a = ap.parse_args()

    if a.list:
        list_devices()
        return
    if not a.file and not a.stop and not a.desktop:
        ap.error(_("give a video, songs or photos (or --desktop / --list / --stop)"))
    for path in a.file:
        if not os.path.exists(path):
            sys.exit(_("No such file: {path}").format(path=path))
    kind, files = media.collect(a.file)
    if a.file and kind is None:
        sys.exit(_("That doesn't look like a video, song or photo."))
    a.file = files[0] if kind == "video" else None
    if a.subs:
        if not a.file:
            sys.exit(_("--subs is for videos"))
        entries = core.list_subtitles(os.path.abspath(a.file))
        if not entries:
            print(_("No subtitles found next to this video or inside it."))
        for n, e in enumerate(entries, 1):
            print(f" {n}. {e['label']}" + ("" if e["ok"] else f"  ({e['why']})"))
        return
    start_at = parse_start(a.start)
    subtitle = None
    if a.sub:
        entry = pick_subtitle(os.path.abspath(a.file), a.sub)
        if entry:
            try:
                subtitle = core.prepare_subtitle(entry, os.path.abspath(a.file))
                print(_("Subtitles: {name}").format(name=entry["label"]))
            except core.TVError as e:
                print(_("Couldn't use those subtitles: {error}").format(error=e))

    cfg = core.load_config()
    tv = core.find_tv(location=(cfg.get("tv") or {}).get("location"), host=a.tv)
    if not tv:
        sys.exit(_("No TV found. Is it switched on and on the same network? (opuscast --list shows what's there)"))
    cfg["tv"] = {"location": tv.location, "name": tv.name}
    core.save_config(cfg)

    if a.stop:
        tv.stop()
        print(_("Stopped."))
        return
    speaker = tv.plays_video() is False
    if speaker and (a.desktop or kind in ("video", "image")):
        sys.exit(_("{device} plays music only - choose a TV for videos, photos and the desktop.").format(
            device=tv.name))

    server = core.MediaServer()
    try:
        if a.desktop:
            cast_desktop(tv, server, cfg, a)
            print(_("Finished."))
            return
        if kind == "audio":
            if not play_songs(tv, server, files):
                sys.exit(1)
            print(_("Finished."))
            return
        if kind == "image":
            if not show_photos(tv, server, files, max(1.0, a.every)):
                sys.exit(1)
            return
        if a.intro:
            import opuscast_intro
            print(_("Skynet is booting…"))
            wait_until_done(tv, server, start(tv, server, opuscast_intro.ensure_intro()))
        for n, video in enumerate(files):
            item = start(tv, server, video, start_at if n == 0 else 0, subtitle=subtitle if n == 0 else None)
            print(_("Playing on {tv}: {title}").format(tv=tv.name, title=item["title"]))
            if n == 0:
                print(_("(keep this open while you watch - Ctrl+C stops)"))
            result = wait_until_done(tv, server, item)
            if result is None:
                sys.exit(1)
            if result is False:
                break  # stopped on the TV
        print(_("Finished."))
    except KeyboardInterrupt:
        try:
            tv.stop(timeout=3)
        except core.TVError:
            pass
        print("\n" + _("Stopped."))
    except (core.TVError, RuntimeError, OSError) as e:
        sys.exit(_("Error: {error}").format(error=e))
    finally:
        server.close()


if __name__ == "__main__":
    main()
