def which(name):
    return shutil.which(name) or shutil.which(name, path="/usr/sbin:/sbin:/usr/local/sbin")


def icon_name(*names):
    theme = Gtk.IconTheme.get_default()
    return next((n for n in names if theme.has_icon(n)), names[-1])


def shorten(text, n=60):
    return text if len(text) <= n else text[:n - 1] + "…"


# ---------------------------------------------------------------- background helpers

class Worker:
    """Runs TV commands one after another, off the GUI thread."""

    def __init__(self, on_error):
        self.q, self.on_error = queue.Queue(), on_error
        threading.Thread(target=self._run, daemon=True).start()

    def submit(self, fn, *args, done=None, **kwargs):
        self.q.put((fn, args, kwargs, done))

    def _run(self):
        while True:
            fn, args, kwargs, done = self.q.get()
            try:
                result = fn(*args, **kwargs)
            except Exception as e:  # noqa: BLE001 - every failure is shown to the user
                GLib.idle_add(self.on_error, e)
                continue
            if done:
                GLib.idle_add(self._finish, done, result)

    @staticmethod
    def _finish(done, result):
        done(result)
        return False


class Poller(threading.Thread):
    """Asks the TV what it's doing: twice a second while playing, every 5 s otherwise."""

    def __init__(self, callback):
        super().__init__(daemon=True)
        self.callback, self.tv, self.wake = callback, None, threading.Event()
        self.active = False

    def run(self):
        last_volume = 0.0
        while True:
            tv = self.tv
            if tv is None:
                self.wake.wait(1)
                self.wake.clear()
                continue
            result = {"tv": tv}
            try:
                result["state"] = tv.state()
                result["pos"], result["dur"], result["uri"] = tv.position()
                if time.monotonic() - last_volume > 4:
                    last_volume = time.monotonic()
                    try:
                        result["volume"] = tv.get_volume()
                    except core.TVError:
                        pass
            except core.TVError as e:
                result["error"] = str(e)
            GLib.idle_add(self.callback, result)
            self.wake.wait(2.0 if "error" in result else 0.5 if self.active else 5.0)
            self.wake.clear()


class Preview:
    """A muted copy of the video on this PC, kept in step with the TV."""

    def __init__(self, on_error, on_widget):
        self.on_error, self.on_widget = on_error, on_widget
        self.ok, self.reason, self.widget, self.gl = False, "", None, False
        self.path, self.playing, self.prerolled, self.pending = None, False, False, None
        if Gst is None:
            self.reason = _("GStreamer isn't installed")
            return
        self.pb = Gst.ElementFactory.make("playbin", "opuscast-preview")
        if self.pb is None:
            self.reason = _("the GStreamer base plugins aren't installed")
            return
        if not self._make_sink(prefer_gl=os.environ.get("OPUSCAST_PREVIEW_SINK") != "gtk"):
            self.reason = _("the GStreamer GTK plugin isn't installed")
            return
        self.pb.set_property("flags", 0x1 | 0x200)  # video + deinterlace only: no audio, no subtitles
        bus = self.pb.get_bus()
        bus.add_signal_watch()
        bus.connect("message::error", self._on_error)
        bus.connect("message::async-done", self._on_async_done)
        self.ok = True

    def _make_sink(self, prefer_gl):
        sink = widget = None
        if prefer_gl:
            gl, gl_bin = Gst.ElementFactory.make("gtkglsink", None), Gst.ElementFactory.make("glsinkbin", None)
            if gl and gl_bin:
                gl_bin.set_property("sink", gl)
                sink, widget, self.gl = gl_bin, gl.props.widget, True
        if sink is None:
            plain = Gst.ElementFactory.make("gtksink", None)
            if plain:
                sink, widget, self.gl = plain, plain.props.widget, False
        if sink is None:
            return False
        self.pb.set_property("video-sink", sink)
        old, self.widget = self.widget, widget
        if old is not None:
            self.on_widget(old, widget)
        return True

    def _on_error(self, _bus, msg):
        err, _debug = msg.parse_error()
        path, pos = self.path, self.position() or 0.0
        self.pb.set_state(Gst.State.NULL)
        if self.gl and self._make_sink(prefer_gl=False):  # GL trouble: fall back to the plain sink once
            if path:
                self.load(path, pos)
            return
        self.unload()
        self.on_error(err.message)

    def load(self, path, pos=0.0):
        self.pb.set_state(Gst.State.NULL)
        self.pb.set_property("uri", Gst.filename_to_uri(path))
        self.path, self.playing, self.prerolled, self.pending = path, False, False, pos
        self.pb.set_state(Gst.State.PAUSED)

    def unload(self):
        if self.ok:
            self.pb.set_state(Gst.State.NULL)
        self.path, self.playing, self.prerolled, self.pending = None, False, False, None

    def _on_async_done(self, *_args):
        self.prerolled = True
        if self.pending is not None:
            pos, self.pending = self.pending, None
            self._seek(pos, True)

    def seek(self, pos, accurate=True):
        if not self.path:
            return
        if not self.prerolled:
            self.pending = pos
            return
        self._seek(pos, accurate)

    def _seek(self, pos, accurate):
        flags = Gst.SeekFlags.FLUSH | (Gst.SeekFlags.ACCURATE if accurate
                                       else Gst.SeekFlags.KEY_UNIT | Gst.SeekFlags.SNAP_NEAREST)
        self.pb.seek_simple(Gst.Format.TIME, flags, int(max(0.0, pos) * Gst.SECOND))

    def set_playing(self, on):
        if self.path and on != self.playing:
            self.playing = on
            self.pb.set_state(Gst.State.PLAYING if on else Gst.State.PAUSED)

    def position(self):
        if not (self.path and self.prerolled):
            return None
        ok, p = self.pb.query_position(Gst.Format.TIME)
        return p / Gst.SECOND if ok and p >= 0 else None


