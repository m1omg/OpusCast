    # ------------------------------------------------------------ recent list

    def _recent_item(self, path):
        return next((r for r in self.cfg["recent"] if r.get("path") == path), None)

    def _remember(self, path, pos=None, dur=None, watched=None, sub=KEEP):
        old = self._recent_item(path) or {}
        item = {"path": path, "pos": old.get("pos", 0), "dur": old.get("dur", 0),
                "watched": old.get("watched", False), "sub": old.get("sub")}
        if pos is not None:
            item["pos"] = round(pos, 1)
            if pos > 5:
                item["watched"] = False
        if dur:
            item["dur"] = dur
        if watched is not None:
            item["watched"] = watched
        if sub is not KEEP:
            item["sub"] = sub
        self.cfg["recent"] = [item] + [r for r in self.cfg["recent"] if r.get("path") != path][:19]
        self._save()

    def _forget(self, path):
        self.cfg["recent"] = [r for r in self.cfg["recent"] if r.get("path") != path]
        self._save()
        self._refresh_recent()

    def _refresh_recent(self):
        for child in self.recent_list.get_children():
            child.destroy()
        home = os.path.expanduser("~")
        for item in self.cfg["recent"]:
            path = item.get("path", "")
            if not os.path.isfile(path):
                continue
            pos, dur, watched = item.get("pos", 0), item.get("dur", 0), item.get("watched")
            row = Gtk.ListBoxRow()
            row.path = path
            hb = Gtk.Box(spacing=12, margin=8)
            hb.pack_start(Gtk.Image.new_from_icon_name("video-x-generic", Gtk.IconSize.DND), False, False, 0)
            vb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3, valign=Gtk.Align.CENTER)
            title = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
            title.set_markup(f"<b>{GLib.markup_escape_text(os.path.splitext(os.path.basename(path))[0])}</b>")
            vb.pack_start(title, False, False, 0)
            if watched:
                status = _("Watched")
            elif pos > 5 and dur:
                status = _("Resume at {pos} of {dur}").format(pos=fmt(pos), dur=fmt(dur))
            elif pos > 5:
                status = _("Resume at {pos}").format(pos=fmt(pos))
            else:
                status = _("Not started")
            folder = os.path.dirname(path)
            if folder.startswith(home):
                folder = "~" + folder[len(home):]
            sub = Gtk.Label(label=f"{status}  ·  {folder}", xalign=0, ellipsize=Pango.EllipsizeMode.MIDDLE)
            sub.get_style_context().add_class("dim-label")
            vb.pack_start(sub, False, False, 0)
            if pos > 5 and dur and not watched:
                vb.pack_start(Gtk.ProgressBar(fraction=min(1.0, pos / dur)), False, False, 2)
            hb.pack_start(vb, True, True, 0)
            if pos > 5 and not watched:
                again = Gtk.Button.new_from_icon_name("media-skip-backward-symbolic", Gtk.IconSize.BUTTON)
                again.set_tooltip_text(_("Play from the beginning"))
                again.set_relief(Gtk.ReliefStyle.NONE)
                again.set_valign(Gtk.Align.CENTER)
                again.connect("clicked", lambda _b, p=path: self.play_file(p, start_at=0))
                hb.pack_start(again, False, False, 0)
            remove = Gtk.Button.new_from_icon_name("window-close-symbolic", Gtk.IconSize.BUTTON)
            remove.set_tooltip_text(_("Remove from this list"))
            remove.set_relief(Gtk.ReliefStyle.NONE)
            remove.set_valign(Gtk.Align.CENTER)
            remove.connect("clicked", lambda _b, p=path: self._forget(p))
            hb.pack_start(remove, False, False, 0)
            row.add(hb)
            self.recent_list.add(row)
        self.recent_list.show_all()

    # ------------------------------------------------------------ playback

    def choose_file(self):
        dlg = Gtk.FileChooserNative.new(_("Choose what to play on the TV"), self, Gtk.FileChooserAction.OPEN,
                                        _("_Play"), _("_Cancel"))
        dlg.set_select_multiple(True)

        def add_filter(name, mimes, exts):
            f = Gtk.FileFilter()
            f.set_name(name)
            for m in mimes:
                f.add_mime_type(m)
            for ext in exts:
                f.add_pattern("*" + ext)
                f.add_pattern("*" + ext.upper())
            dlg.add_filter(f)
        add_filter(_("Videos, music and photos"), ("video/*", "audio/*", "image/*"),
                   core.VIDEO_EXTS + core.AUDIO_EXTS + core.IMAGE_EXTS)
        add_filter(_("Videos"), ("video/*",), core.VIDEO_EXTS)
        add_filter(_("Music"), ("audio/*",), core.AUDIO_EXTS)
        add_filter(_("Photos"), ("image/*",), core.IMAGE_EXTS)
        add_filter(_("All files"), (), ("",))
        start = self.cfg.get("last_dir") or GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_VIDEOS)
        if start and os.path.isdir(start):
            dlg.set_current_folder(start)
        response = dlg.run()
        paths = dlg.get_filenames()
        dlg.destroy()
        if response == Gtk.ResponseType.ACCEPT and paths:
            self.open_paths(paths)

    def _on_drop(self, _w, _ctx, _x, _y, data, _info, _time):
        self.dropzone.get_style_context().remove_class("hover")
        paths = []
        for uri in data.get_uris() or []:
            try:
                paths.append(GLib.filename_from_uri(uri)[0])
            except GLib.Error:
                continue
        subs = [p for p in paths if p.lower().endswith(core.SUB_EXTS)]
        if subs and self.session and self.session["kind"] == "movie" and len(subs) == len(paths):
            self._use_sub_file(subs[0])  # a subtitle file dropped while a video plays
            return
        self.open_paths([p for p in paths if not p.lower().endswith(core.SUB_EXTS)])

    def open_paths(self, paths):
        """Play what was chosen: the (first) video, the songs one after another, or the photos as a
        slideshow - one photo brings the rest of its folder along, to flip through."""
        kind, files = media.collect(paths)
        if kind is None:
            self.show_info(_("That doesn't look like a video, song or photo on this PC."), WARNING)
            return
        self.cfg["last_dir"] = os.path.dirname(files[0])
        if kind == "video":
            self.play_file(files[0])
        elif kind == "audio":
            self.play_music(files, 0)
        elif len(files) == 1:
            folder = media.folder_items(files[0], "image")
            self.show_photos(folder, folder.index(files[0]) if files[0] in folder else 0)
        else:
            self.show_photos(files, 0)

    def _ready_for(self, what, fn, args):
        """True if the TV is there and can do this; otherwise say why (or wait for the TV)."""
        if not self.tv:
            self.pending_play = (fn, args)
            self.show_info(_("Waiting for the TV - it starts as soon as the TV is found."))
            return False
        if what != "audio" and self._is_speaker():
            self.show_info(_("{device} plays music only - choose a TV for videos, photos and the desktop.").format(
                device=self.tv.name), WARNING, [(_("Show devices"), lambda: self.dev_button.set_active(True))])
            return False
        return True

    def _is_speaker(self):
        sink = self.tv.cached_sink() if self.tv else None
        return bool(sink) and "*" not in sink and not any(m.startswith("video/") for m in sink)

    def play_file(self, path, start_at=None):
        path = os.path.abspath(path)
        if not os.path.isfile(path):
            self.show_info(_("File not found: {path}").format(path=path), WARNING)
            return
        if core.media_kind(path) in ("audio", "image"):
            self.open_paths([path])
            return
        if not self._ready_for("video", self.play_file, (path, start_at)):
            return
        self.cfg["last_dir"] = os.path.dirname(path)
        item = self._recent_item(path)
        if start_at is None:
            start_at = item["pos"] if item and not item.get("watched") and item.get("pos", 0) > 5 else 0
        sub_id = item.get("sub") if item else None
        if self.session:
            self._end_session(stop_tv=False)
        self.clear_info()
        self._remember(path, pos=start_at)
        self.gen += 1
        gen = self.gen
        if not sub_id:
            self._begin(gen, path, start_at, None, None)
            return
        self._show_player(os.path.splitext(os.path.basename(path))[0], _("Preparing subtitles…"))

        def work():  # the subtitle used last time, so it's on from the start
            entries = core.list_subtitles(path)
            entry = next((e for e in entries if e["id"] == sub_id and e["ok"]), None)
            if entry is None and sub_id.startswith("file:") and os.path.isfile(sub_id[5:]):
                entry = core.subtitle_file_entry(sub_id[5:])
                entries.append(entry)
            data = None
            if entry:
                try:
                    data = core.prepare_subtitle(entry, path)
                except core.TVError:
                    entry = None
            GLib.idle_add(self._begin, gen, path, start_at, (entry, data) if entry else None, entries)
        threading.Thread(target=work, daemon=True).start()

    def _begin(self, gen, path, start_at, subtitle, subs):
        if gen != self.gen:
            return False
        if self.intro_switch.get_active():
            ok, reason = intro.available()
            if ok:
                self._start_intro(path, start_at, subtitle, subs)
                return False
            self.show_info(_("Skipping the Skynet intro: it {reason}.").format(reason=reason), WARNING)
        self._start_session("movie", path, start_at, subtitle=subtitle, subs_on=bool(subtitle), subs=subs)
        return False

    def _start_intro(self, path, start_at, subtitle, subs):
        self.gen += 1
        gen = self.gen
        self._show_player(_("Skynet is booting…"), _("Preparing the intro…"))

        def work():
            try:
                clip = intro.ensure_intro()
            except Exception as e:  # noqa: BLE001
                GLib.idle_add(self._intro_failed, gen, path, start_at, subtitle, subs, str(e))
                return
            GLib.idle_add(self._intro_ready, gen, clip, (path, start_at, subtitle, subs))
        threading.Thread(target=work, daemon=True).start()

    def _intro_ready(self, gen, clip, next_up):
        if gen == self.gen:
            self._start_session("intro", clip, 0, next_up=next_up)
        return False

    def _intro_failed(self, gen, path, start_at, subtitle, subs, message):
        if gen == self.gen:
            self.show_info(_("The Skynet intro failed ({error}) - playing the video straight away.").format(
                error=message), WARNING)
            self._start_session("movie", path, start_at, subtitle=subtitle, subs_on=bool(subtitle), subs=subs)
        return False

    def _start_session(self, kind, path, start_at, next_up=None, subtitle=None, subs_on=False, subs=None,
                       media=None, title=None, **extra):
        """Start something on the TV. kind: movie, intro, music (one song of a queue), photo (one photo
        of a slideshow) or desktop; media is already published for all but videos."""
        self.gen += 1
        entry, data = subtitle if subtitle else (None, None)
        if media is None:
            try:
                media = self.server.publish(path, data)
            except OSError as e:
                self.show_info(_("Can't read that file: {error}").format(error=e), ERROR)
                self.stack.set_visible_child_name("pick")
                return
        now = time.monotonic()
        self.session = {"kind": kind, "path": path, "media": media, "next": next_up, "seen_playing": False,
                        "started": now, "gen": self.gen, "subs": subs, "sub_entry": entry, "sub_on": False,
                        "sub_tv_changed": False, "caption_api": None, "sub_loading": bool(entry and subs_on),
                        "paths": {entry["id"]: media["sub_path"]} if entry else {},
                        "start_at": start_at, "subs_on": subs_on,
                        # starting it failed, but the TV may still play it: a Samsung asks "Allow this
                        # device?" the first time, holds the commands meanwhile and carries them out once allowed
                        "start_error": None, "start_failed": 0.0, "answering_since": 0.0, "retried": False,
                        "wait_bar": None, "queue": None, "index": 0, "cast": None, "tags": {}}
        self.session.update(extra)
        # the URLs of this song/photo and the one before: while switching, the TV may still report the old one
        self.session["ours"] = (list(extra.get("ours") or []) + [media["url_path"]])[-3:]
        self.poller.active = True
        self.tv_state, self.tv_pos, self.tv_pos_raw, self.pos_seen, self.tv_dur = "TRANSITIONING", float(start_at), None, now, 0.0
        self.hold = (float(start_at), now, 30.0) if start_at else None
        self.range_dur = None
        self._set_mode(kind)
        self._show_player(title or (_("Skynet is booting…") if kind == "intro" else media["title"]),
                          _("Starting on the TV…"))
        if self.preview_switch.get_active() and kind in ("movie", "intro"):
            self._preview_load()
        gen = self.gen
        if subs_on:
            self.last_caption_cmd = now
        if not self.event_sids and not self.events_pending:  # e.g. the TV didn't answer until it was allowed
            self._subscribe_events(self.tv)
        self._start_on_tv(self.session)
        GLib.timeout_add_seconds(15, self._check_fetched, gen)
        if kind == "movie" and subs is None:
            def find():
                found = core.list_subtitles(path)
                GLib.idle_add(self._subs_found, gen, found)
            threading.Thread(target=find, daemon=True).start()
        self._update_sub_button()
        if kind == "movie" and start_at > 5:
            self.show_info(_("Carrying on from {pos}.").format(pos=fmt(start_at)), INFO,
                           [(_("Start from the beginning"), lambda: self.seek_to(0))])

    def _start_on_tv(self, s):
        """Hand the session's video to the TV (stop, set, play, resume point, subtitle)."""
        tv, gen = self.tv, s["gen"]

        def work():
            try:
                return core.play_media(tv, self.server, s["media"], s["start_at"], subs_on=s["subs_on"]), None
            except Exception as e:  # noqa: BLE001 - shown to the user
                return None, e
        self.worker.submit(work, done=lambda r: self._play_started(gen, *r))

    def _play_started(self, gen, captions, error=None):
        self.poller.wake.set()
        s = self.session
        if not (s and s["gen"] == gen):
            return
        if error is not None:
            self._start_failed(s, error)
            return
        s["start_error"] = None  # (a retry worked)
        if not s["sub_entry"]:
            return
        s["sub_loading"] = False
        self.last_caption_cmd = time.monotonic()
        if captions == "ok":
            s["sub_on"], s["caption_api"] = True, True
        elif captions == "unsupported":
            s["sub_on"], s["caption_api"] = True, False  # sent with the video; the TV decides
        self._update_sub_button()

    def _start_failed(self, s, error):
        """The start commands failed. Keep the session: the TV may be waiting for "Allow" and play it then."""
        s["sub_loading"] = False
        if s["seen_playing"]:  # it plays anyway
            self.show_info(_("The TV didn't accept that: {error}").format(error=error), WARNING)
            self._update_sub_button()
            self._update_status()
            return
        s["start_error"], s["start_failed"], s["answering_since"] = error, time.monotonic(), 0.0
        text = _("The TV hasn't taken the video yet ({error}). If the TV asks whether to allow this PC, "
                 "choose Allow - the video then starts by itself.") if s["kind"] in ("movie", "intro") else \
            _("The TV hasn't taken it yet ({error}). If the TV asks whether to allow this PC, choose Allow - "
              "it then starts by itself.")
        s["wait_bar"] = self.show_info(text.format(error=error), WARNING,
                                       [(_("Try again"), self._retry_start), (_("Stop"), self.stop)])
        GLib.timeout_add_seconds(120, self._give_up, s["gen"], s["start_failed"])
        self._update_sub_button()
        self._update_status()

    def _retry_start(self):
        """Send the start commands again, in the same session (same address for the TV)."""
        s = self.session
        if not s or s["seen_playing"]:
            return
        s["retried"] = True
        self._drop_bar(s["wait_bar"])
        s["sub_loading"] = bool(s["sub_entry"] and s["subs_on"])
        if not self.event_sids and not self.events_pending and self.tv:
            self._subscribe_events(self.tv)
        self._start_on_tv(s)
        self._update_sub_button()
        self._update_status()

    def _give_up(self, gen, stamp):
        s = self.session
        if (s and s["gen"] == gen and not s["seen_playing"] and s["start_error"] is not None
                and s["start_failed"] == stamp):
            error = s["start_error"]
            self._end_session(stop_tv=False)
            self.show_info(_("Couldn't start it on the TV: {error}").format(error=error), ERROR)
        return False

    @staticmethod
    def _drop_bar(bar):
        if bar is not None and bar.get_parent() is not None:
            bar.destroy()

    def _recovered(self, s):
        """The TV plays it after all (allowed on the TV): carry on as if the start had worked."""
        s["start_error"] = None
        self._drop_bar(s["wait_bar"])
        tv = self.tv
        if s["start_at"] > 1:  # the resume point was never sent
            self.hold = (float(s["start_at"]), time.monotonic(), 30.0)
            self.worker.submit(tv.seek, s["start_at"], done=lambda _r: self.poller.wake.set())
        if s["kind"] == "movie" and s["sub_entry"] and s["subs_on"] and not s["sub_on"]:
            self.last_caption_cmd = time.monotonic()

            def done(result, sess=s):
                if sess is self.session:
                    sess["caption_api"] = result == "ok"
                    sess["sub_on"] = True  # announced with the video either way
                    self._update_sub_button()
            self.worker.submit(core.show_subtitle, tv, self.server, s["media"], s["media"]["sub_path"], done=done)

    def _subs_found(self, gen, found):
        s = self.session
        if s and s["gen"] == gen and s["subs"] is None:
            s["subs"] = found
            self._update_sub_button()
            if self.sub_popover.get_visible():
                self._fill_sub_menu()
        return False

    def _show_player(self, title, status):
        self.title_label.set_text(title)
        self.status_label.set_text(status)
        self.placeholder_label.set_text(_("Playing on {tv}").format(tv=self.tv.name) if self.tv else "")
        self.elapsed.set_text("0:00:00")
        self.total.set_text("--:--")
        self.stack.set_visible_child_name("player")
        self._update_video_area()

    def _check_fetched(self, gen):
        s = self.session
        if s and s["gen"] == gen and not s["media"]["requested"].is_set() and s["start_error"] is None:
            self._firewall_help()
        return False

    def _firewall_help(self):
        host, port = self.tv.host, self.server.port
        rule = f"rule family=ipv4 source address={host} port port={port} protocol=tcp accept"
        commands, fixes = [], []
        if which("ufw"):
            commands.append(f"sudo ufw allow from {host} to any port {port} proto tcp")
            fixes.append([which("ufw"), "allow", "from", host, "to", "any", "port", str(port), "proto", "tcp"])
        if which("firewall-cmd"):
            commands.append(f"sudo firewall-cmd --permanent --add-rich-rule='{rule}' && sudo firewall-cmd --reload")
            fwc = which("firewall-cmd")
            fixes.append(["sh", "-c", f"'{fwc}' --permanent --add-rich-rule='{rule}' && '{fwc}' --reload"])
        if not commands:
            commands = [f"sudo ufw allow from {host} to any port {port} proto tcp"]
        actions = [(_("Allow it (asks for your password)"), lambda: self._run_root(fixes[0]))] \
            if fixes and which("pkexec") else []
        self.show_info(_("The TV hasn't started loading it. A firewall on this PC may be blocking it. "
                         "This lets the TV in:"), WARNING, actions, selectable="\n".join(commands))

    def _run_root(self, cmd):
        def work():
            try:
                ok = subprocess.run([which("pkexec"), *cmd], capture_output=True, timeout=120).returncode == 0
            except (OSError, subprocess.SubprocessError):
                ok = False
            GLib.idle_add(self._root_done, ok)
        threading.Thread(target=work, daemon=True).start()

    def _root_done(self, ok):
        s = self.session
        if ok and s:
            self.show_info(_("Firewall updated - starting again."))
            self._restart_current(s)
        elif ok:
            self.show_info(_("Firewall updated."))
        else:
            self.show_info(_("The firewall wasn't changed."), WARNING)
        return False

    def est_pos(self):
        if self.hold:
            return self.hold[0]
        p = self.tv_pos
        if self.tv_state == "PLAYING":
            p += min(time.monotonic() - self.pos_seen, 1.0)
        return min(p, self.tv_dur) if self.tv_dur else p

    def _on_poll(self, r):
        if r["tv"] is not self.tv:
            return False
        if "error" in r:
            self.poll_errors += 1
            if self.session:
                self.session["answering_since"] = 0.0
            if self.poll_errors >= 3:
                self._set_subtitle(_("Can't reach {tv} - is it on?").format(tv=self.tv.name))
            s = self.session
            if s and s.get("watch"):  # a TV that doesn't answer may still be watching the desktop
                self._follow_desktop(s, None, None)
            return False
        if self.poll_errors >= 3:
            self._set_subtitle(_("Connected to {tv}").format(tv=self.tv.name))
        self.poll_errors = 0
        if r.get("volume") is not None and time.monotonic() - self.vol_touched > 3:
            self.setting_vol = True
            self.volume.set_value(r["volume"] / 100)
            self.setting_vol = False
        s = self.session
        if not s:
            return False
        state, pos, dur, uri = r["state"], r["pos"], r["dur"], r["uri"]
        current = not uri or s["media"]["url_path"] in uri
        ours = current or any(p in uri for p in s["ours"])
        now = time.monotonic()
        was_seen = s["seen_playing"]
        photo = s["kind"] == "photo"
        if current:
            # a photo counts as shown once the TV fetched it: some TVs report STOPPED while showing one
            if state == "PLAYING" or (photo and s["media"]["requested"].is_set() and state != "TRANSITIONING"):
                s["seen_playing"] = True
            if s["seen_playing"] and state in ("PLAYING", "PAUSED_PLAYBACK", "TRANSITIONING"):
                if pos is not None:
                    if pos != self.tv_pos_raw:
                        self.tv_pos_raw, self.pos_seen = pos, now
                    self.tv_pos = float(pos)
                if dur:
                    self.tv_dur = float(dur)
                self.tv_state = state
        if self.hold:
            target, since, limit = self.hold
            arrived = current and pos is not None and s["seen_playing"] and target - 2 <= pos <= target + 8
            if arrived or now - since > limit:
                self.hold = None
        if photo:
            finished = s["seen_playing"] and bool(uri) and not ours  # something else is on the TV now
        elif s.get("watch"):  # the shared desktop: the TV leaving it doesn't end it
            finished = False
            if not s["seen_playing"] and core.showing_live(s["media"], state, uri):
                s["seen_playing"] = True  # (taken from OpusCast among the TV's sources)
            if self._follow_desktop(s, state, uri):
                return False
        else:
            finished = s["seen_playing"] and (state in ("STOPPED", "NO_MEDIA_PRESENT") or not ours)
        if finished:
            # a song that stopped at its end: the next one (stopped half-way: the TV's Stop button)
            length = self.tv_dur or s["tags"].get("duration") or 0
            s["ended"] = ours and (not length or self.tv_pos >= length - 5)
            self._session_finished()
            return False
        if not was_seen and s["seen_playing"] and s["start_error"] is not None:
            self._recovered(s)
        if not s["seen_playing"] and s["start_error"] is not None:
            # the TV answers again (allowed?): if it doesn't start the video by itself, send it once more
            if not s["answering_since"]:
                s["answering_since"] = now
            if not s["retried"] and now - s["answering_since"] >= 4:
                self._retry_start()
        if (not s["seen_playing"] and s["start_error"] is None and now - s["started"] > 40 and not photo
                and state in ("STOPPED", "NO_MEDIA_PRESENT")):
            kind = s["kind"]
            self._end_session(stop_tv=False)
            self.show_info({"music": _("The TV didn't start the song. It may not play this format."),
                            "desktop": _("The TV didn't start showing the desktop.")}.get(kind, _(
                                "The TV didn't start the video. It may not support this file's format "
                                "(Dolby Vision files often don't work on Samsung TVs).")), ERROR)
            return False
        self._update_status()
        self._sync_preview()
        return False

    def _update_status(self):
        s = self.session
        if not s:
            return
        st = self.tv_state if s["seen_playing"] else "STARTING"
        text = {"PLAYING": _("Playing"), "PAUSED_PLAYBACK": _("Paused"), "TRANSITIONING": _("Loading…")}.get(
            st, _("Starting on the TV…"))
        if s["kind"] == "intro" and st == "PLAYING":
            text = _("Skynet is coming online")
        if not s["seen_playing"] and s["start_error"] is not None:
            text = _("Waiting for the TV…")
        if s.get("sub_loading"):
            text = _("Loading subtitles…")
        if s["kind"] == "photo" and s["start_error"] is None:
            text = _("On the TV") if s["seen_playing"] else _("Sending the photo…")
        w = s.get("watch")
        if w and w.sent_at is not None:
            text = _("Showing it on the TV again…")
        elif w and w.away:
            text = _("Not on the TV")
        line = f"{text} - {self.tv.name}" if self.tv else text
        if s["kind"] == "music":
            line = " · ".join(x for x in (media.song_line(s["tags"]), line) if x)
        elif s["kind"] == "photo":
            line = f"{s['index'] + 1} / {len(s['queue'])}  ·  {line}"
        elif s["kind"] == "desktop" and s["cast"]:
            line = f"{s['cast'].describe()}  ·  {line}"
        self._set_text(self.status_label, line)
        icon = "media-playback-pause-symbolic" if st == "PLAYING" else "media-playback-start-symbolic"
        if icon != self.play_icon:
            self.play_icon = icon
            for img in self.play_imgs:
                img.set_from_icon_name(icon, Gtk.IconSize.DND)

    def _tick(self):
        s = self.session
        if s and not self.dragging and s["kind"] not in ("photo", "desktop"):
            pos = self.est_pos()
            if self.tv_dur and self.tv_dur != self.range_dur:
                self.range_dur = self.tv_dur
                self.scale.set_range(0, self.tv_dur)
                self.total.set_text(fmt(self.tv_dur))
            self.scale.set_sensitive(bool(self.tv_dur))
            self.scale.set_value(pos)
            self._set_text(self.elapsed, fmt(pos))
        now = time.monotonic()
        if s and s["kind"] == "movie" and s["seen_playing"] and now - self.last_save > 15:
            self.last_save = now
            self._remember(s["path"], pos=self.est_pos(), dur=self.tv_dur)
        return True

    def _session_finished(self):
        s = self.session
        if s["kind"] == "intro" and s["next"]:
            path, start_at, subtitle, subs = s["next"]
            self.session = None
            self._start_session("movie", path, start_at, subtitle=subtitle, subs_on=bool(subtitle), subs=subs)
        elif s["kind"] == "music" and s.get("ended") and s["index"] + 1 < len(s["queue"]):
            self._go_track(s["queue"], s["index"] + 1)
        else:
            self._end_session(stop_tv=False)

    def _end_session(self, stop_tv=True):
        s, self.session = self.session, None
        if not s:
            return
        self.poller.active = False
        self.gen += 1
        if s["kind"] == "movie" and s["seen_playing"]:
            pos, dur = self.est_pos(), self.tv_dur
            watched = bool(dur) and (pos >= dur - 90 or pos >= dur * 0.95)
            self._remember(s["path"], pos=0 if watched else pos, dur=dur, watched=watched)
        if stop_tv and self.tv:
            self.worker.submit(self.tv.stop)
        if s["cast"]:
            threading.Thread(target=s["cast"].stop, daemon=True).start()
        if s.get("source"):
            threading.Thread(target=s["source"].close, daemon=True).start()
        self._drop_bar(s.get("away_bar"))  # "it's still shared" isn't true any more
        self._cancel_slide()
        self.preview.unload()
        self.hold = None
        self.skip_intro_btn.hide()
        self.sub_button.hide()
        self.tracks_button.hide()
        self.sub_popover.popdown()
        self.tracks_popover.popdown()
        self._set_art(None)
        self.stack.set_visible_child_name("pick")
        self._update_video_area()
        self._refresh_recent()

    def toggle_play(self):
        if not (self.session and self.tv):
            return
        if self.session["kind"] == "photo":
            self.toggle_slideshow()
            return
        if self.session["kind"] == "desktop":
            if self.session.get("watch") and self.session["watch"].away:
                self.show_desktop_again()
            return  # a live picture: pausing would only make it fall behind
        if self.tv_state == "PLAYING":
            self.tv_pos, self.tv_state = self.est_pos(), "PAUSED_PLAYBACK"
            self.worker.submit(self.tv.pause, done=lambda _r: self.poller.wake.set())
        else:
            self.tv_state, self.pos_seen = "PLAYING", time.monotonic()
            self.worker.submit(self.tv.play, done=lambda _r: self.poller.wake.set())
        self._update_status()
        self._sync_preview()

    def seek_to(self, target):
        if not (self.session and self.tv):
            return
        dur = self.tv_dur
        target = max(0.0, min(target, dur - 2) if dur else target)
        self.hold = (target, time.monotonic(), 8.0)
        self.worker.submit(self.tv.seek, target, done=lambda _r: self.poller.wake.set())
        if self.preview.path:
            self.preview.seek(target)
        self._tick()

    def skip(self, delta):
        self.seek_to(self.est_pos() + delta)

    def skip_intro(self):
        if self.session and self.session["kind"] == "intro":
            self._session_finished()

    def stop(self):
        if not self.session:  # still preparing (subtitles / intro / a song / the desktop): just go back
            self.gen += 1
            if self.pending_cast:
                cast, self.pending_cast = self.pending_cast, None
                threading.Thread(target=cast.stop, daemon=True).start()
            self.stack.set_visible_child_name("pick")
            return
        w = self.session.get("watch")
        self._end_session(stop_tv=not (w and w.away))  # a TV that left the desktop shows something else now

    # ------------------------------------------------------------ music, photos, the desktop

    def _set_mode(self, kind):
        """Show the controls for what's on: a video (or the intro), songs, photos or the desktop."""
        self.mode = kind
        self.transport.set_visible_child_name({"music": "music", "photo": "photo", "desktop": "live"}.get(kind, "video"))
        self.slider_row.set_visible(kind not in ("photo", "desktop"))
        self.skip_intro_btn.set_visible(kind == "intro")
        self.sub_button.set_visible(kind == "movie")
        self.tracks_button.set_visible(kind == "music")
        self.volume.set_visible(kind != "photo")
        self.placeholder_icon.set_from_icon_name(MODE_ICONS.get(kind, "video-display-symbolic"), Gtk.IconSize.DIALOG)
        self.placeholder_icon.set_pixel_size(96)
        if kind not in ("music", "photo"):
            self._set_art(None)
        self._update_slide_button()

    def _set_art(self, pixbuf):
        if pixbuf is None:
            self.art.clear()
        else:
            self.art.set_from_pixbuf(pixbuf)
        self.art.set_visible(pixbuf is not None)
        self.placeholder_icon.set_visible(pixbuf is None)

    @staticmethod
    def _pixbuf(path=None, data=None, box=(640, 400)):
        """A picture fitted into box and turned upright, or None. Fine to call off the GUI thread."""
        try:
            if data is not None:
                loader = GdkPixbuf.PixbufLoader()
                loader.write(data)
                loader.close()
                pb = loader.get_pixbuf()
            else:  # decoded small straight away: a 50-megapixel photo stays quick
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, box[0] * 2, box[1] * 2, True)
            pb = pb.apply_embedded_orientation() or pb
            scale = min(1.0, box[0] / pb.get_width(), box[1] / pb.get_height())
            if scale < 1.0:
                pb = pb.scale_simple(max(1, round(pb.get_width() * scale)), max(1, round(pb.get_height() * scale)),
                                     GdkPixbuf.InterpType.BILINEAR)
            return pb
        except (GLib.Error, TypeError, ValueError, ZeroDivisionError):
            return None

    def step(self, delta):
        """Next / previous photo or song."""
        s = self.session
        if not s or not s["queue"]:
            return
        n = len(s["queue"])
        if s["kind"] == "photo" and n > 1:
            self._go_photo(s["queue"], (s["index"] + delta) % n)
        elif s["kind"] == "music":
            if delta < 0 and self.est_pos() > 5:
                self.seek_to(0)  # like music players: "previous" first goes back to the start of the song
                return
            i = s["index"] + delta
            if 0 <= i < n:
                self._go_track(s["queue"], i)

    def _restart_current(self, s):
        if s["kind"] == "music":
            self._go_track(s["queue"], s["index"])
        elif s["kind"] == "photo":
            self._go_photo(s["queue"], s["index"])
        elif s["kind"] == "desktop":
            self._end_session(stop_tv=False)
            self.cast_desktop()
        elif s["kind"] == "intro" and s["next"]:
            self.play_file(s["next"][0], s["next"][1])
        else:
            self.play_file(s["path"], self.est_pos())

    # music

    def play_music(self, files, index=0):
        if not files or not self._ready_for("audio", self.play_music, (files, index)):
            return
        if self.session:
            self._end_session(stop_tv=False)
        self.clear_info()
        self._go_track(files, index)

    def _go_track(self, files, index):
        path, tv = files[index], self.tv
        self.gen += 1
        gen = self.gen
        if not (self.session and self.session["kind"] == "music"):
            self._set_mode("music")
        self._show_player(os.path.splitext(os.path.basename(path))[0], _("Starting on the TV…"))

        def work():
            tags = media.audio_tags(path)
            cover = media.song_cover(path, tags)
            art = self._pixbuf(data=cover[1], box=(280, 280)) if cover else None
            play, mime = path, None
            if media.needs_mp3(tv, core.mime_of(path, "audio")):  # the TV doesn't list this format
                GLib.idle_add(self._status_if, gen, _("Converting the song for the TV…"))
                try:
                    play, mime = media.to_mp3(path), "audio/mpeg"
                except (core.TVError, OSError) as e:
                    GLib.idle_add(self._track_failed, gen, files, index, str(e))
                    return
            GLib.idle_add(self._track_ready, gen, files, index, play, mime, tags, cover, art)
        threading.Thread(target=work, daemon=True).start()

    def _status_if(self, gen, text):
        if gen == self.gen:
            self._set_text(self.status_label, text)
        return False

    def _track_ready(self, gen, files, index, play, mime, tags, cover, art):
        if gen != self.gen:
            return False
        prev = self.session
        meta = {k: tags[k] for k in ("artist", "albumartist", "album", "track", "duration") if tags.get(k)}
        try:
            m = self.server.publish(play, kind="audio", mime=mime, title=tags.get("title"), meta=meta)
        except OSError as e:
            return self._track_failed(gen, files, index, str(e))
        if cover:
            m["meta"]["cover_path"], m["meta"]["cover_mime"] = self.server.add_extra(m, *cover), cover[0]
        ours = prev["ours"] if prev and prev["kind"] == "music" else []
        self._start_session("music", files[index], 0, media=m, title=tags.get("title"), queue=files, index=index,
                            tags=tags, ours=ours)
        self._set_art(art)
        self.tracks_label.set_text(f"{index + 1} / {len(files)}")
        self._update_status()
        if index + 1 < len(files):  # have the next song ready (converted, if this TV needs that)
            nxt, tv = files[index + 1], self.tv

            def prepare_next():
                if media.needs_mp3(tv, core.mime_of(nxt, "audio")):
                    media.to_mp3(nxt)
            threading.Thread(target=self._quietly, args=(prepare_next,), daemon=True).start()
        return False

    def _track_failed(self, gen, files, index, error):
        if gen != self.gen:
            return False
        self.show_info(_("Can't play {name}: {error}").format(name=os.path.basename(files[index]), error=error),
                       WARNING)
        if index + 1 < len(files):
            self._go_track(files, index + 1)
        elif self.session:
            self._end_session(stop_tv=False)
        else:
            self.stack.set_visible_child_name("pick")
        return False

    def _fill_tracks(self):
        for child in self.tracks_list.get_children():
            child.destroy()
        s = self.session
        if not s or not s["queue"]:
            return
        for i, path in enumerate(s["queue"]):
            row = Gtk.ListBoxRow()
            row.index = i
            name = os.path.splitext(os.path.basename(path))[0]
            label = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END, margin=6)
            text = GLib.markup_escape_text(("▶  " if i == s["index"] else f"{i + 1}.  ") + name)
            label.set_markup(f"<b>{text}</b>" if i == s["index"] else text)
            row.add(label)
            self.tracks_list.add(row)
        self.tracks_list.show_all()

    def _pick_track(self, index):
        self.tracks_popover.popdown()
        s = self.session
        if s and s["kind"] == "music" and s["queue"]:
            self._go_track(s["queue"], index)

    # photos

    def show_photos(self, files, index=0):
        if not files or not self._ready_for("image", self.show_photos, (files, index)):
            return
        if self.session:
            self._end_session(stop_tv=False)
        self.clear_info()
        self._go_photo(files, index)

    def _go_photo(self, files, index):
        path, tv = files[index], self.tv
        self.gen += 1
        gen = self.gen
        self._cancel_slide()
        if not (self.session and self.session["kind"] == "photo"):
            self._set_mode("photo")
            self._show_player(os.path.basename(path), _("Preparing the photo…"))

        def work():
            try:
                prep = media.prepare_photo(path, tv)
            except OSError as e:
                GLib.idle_add(self._photo_failed, gen, str(e))
                return
            shown = self._pixbuf(path=prep.get("file"), data=prep.get("data"))
            GLib.idle_add(self._photo_ready, gen, files, index, prep, shown)
        threading.Thread(target=work, daemon=True).start()

    def _photo_ready(self, gen, files, index, prep, shown):
        if gen != self.gen:
            return False
        prev, path = self.session, files[index]
        m = self.server.publish(path, kind="image", data=prep.get("data"), mime=prep["mime"],
                                features=prep["features"],
                                meta={"resolution": f"{prep['w']}x{prep['h']}"} if prep["w"] else None)
        ours = prev["ours"] if prev and prev["kind"] == "photo" else []
        warned = bool(prev and prev["kind"] == "photo" and prev.get("warned"))
        self._start_session("photo", path, 0, media=m, title=os.path.basename(path), queue=files, index=index,
                            ours=ours, warned=warned or bool(prep.get("unconverted")))
        if prep.get("unconverted") and not warned:  # once per slideshow
            self.show_info(_("The TV may not show {name}: this PC can't convert this kind of photo. "
                             "This helps:").format(name=os.path.basename(path)), WARNING,
                           selectable=core.install_hint(["photos"]))
        self._set_art(shown)
        self._update_status()
        if self.slideshow:
            self._schedule_slide()
        tv = self.tv
        for j in {(index + 1) % len(files), (index - 1) % len(files)} - {index}:  # the neighbours, for a quick click
            threading.Thread(target=self._quietly, args=(media.prepare_photo, files[j], tv), daemon=True).start()
        return False

    def _photo_failed(self, gen, error):
        if gen != self.gen:
            return False
        self.show_info(_("Can't read that photo: {error}").format(error=error), WARNING)
        if not self.session:
            self.stack.set_visible_child_name("pick")
        elif self.slideshow:
            self._schedule_slide()
        return False

    def toggle_slideshow(self):
        self.slideshow = not self.slideshow
        self._update_slide_button()
        if self.slideshow:
            self._schedule_slide()
        else:
            self._cancel_slide()

    def _update_slide_button(self):
        icon = "media-playback-pause-symbolic" if self.slideshow else "media-playback-start-symbolic"
        self.slide_img.set_from_icon_name(icon, Gtk.IconSize.DND)

    def _schedule_slide(self):
        self._cancel_slide()
        s = self.session
        if s and s["kind"] == "photo":
            self.slide_timer = GLib.timeout_add_seconds(int(self.slide_every.get_active_id() or 5), self._slide_due,
                                                        s["gen"])

    def _cancel_slide(self):
        if self.slide_timer:
            GLib.source_remove(self.slide_timer)
            self.slide_timer = None

    def _slide_due(self, gen):
        self.slide_timer = None
        s = self.session
        if s and s["kind"] == "photo" and s["gen"] == gen and self.slideshow:
            self.step(1)
        return False

    def _on_slide_every(self, combo):
        self.cfg["slide_seconds"] = int(combo.get_active_id() or 5)
        self._save()
        if self.slideshow:
            self._schedule_slide()

    # the desktop

    def _build_desktop_popover(self):
        pop = Gtk.Popover()
        grid = Gtk.Grid(column_spacing=12, row_spacing=10, margin=14)
        rows = []

        def combo(key, choices, default):
            c = Gtk.ComboBoxText()
            for value, text in choices:
                c.append(str(value), text)
            if not c.set_active_id(str(self.cfg.get(key, default))):
                c.set_active_id(str(default))
            c.connect("changed", lambda w: w.get_active_id() and self._desk_set(key, int(w.get_active_id())))
            return c
        self.desk_screen = Gtk.ComboBoxText()
        self.desk_screen.connect("changed", lambda w: w.get_active_id() not in (None, "ask")
                                 and self._desk_set("desk_screen", w.get_active_id()))
        rows.append((_("Screen"), self.desk_screen))
        rows.append((_("Picture"), combo("desk_height", [(1080, _("1080p - sharpest")),
                                                        (720, _("720p - lighter on the PC and Wi-Fi"))], 1080)))
        rows.append((_("Smoothness"), combo("desk_fps", [(30, _("30 pictures a second")),
                                                       (60, _("60 pictures a second - needs a fast PC"))], 30)))
        sound = Gtk.Switch(active=bool(self.cfg.get("desk_sound", True)), halign=Gtk.Align.START)
        sound.connect("notify::active", lambda w, _p: self._desk_set("desk_sound", w.get_active()))
        rows.append((_("Sound from this PC"), sound))
        back = Gtk.Switch(active=bool(self.cfg.get("desk_bring_back", False)), halign=Gtk.Align.START,
                          tooltip_text=_("If the TV leaves the desktop (Back, another source…), OpusCast shows it "
                                         "there again after a few seconds. Leave it again right away to keep it off."))
        back.connect("notify::active", lambda w, _p: self._set_bring_back(w.get_active()))
        rows.append((_("Bring it back if the TV leaves"), back))
        for i, (text, widget) in enumerate(rows):
            grid.attach(Gtk.Label(label=text, xalign=0), 0, i, 1, 1)
            grid.attach(widget, 1, i, 1, 1)
        note = Gtk.Label(label=_("The TV shows the screen a second or two late - fine for slides, photos and "
                                 "videos, not for games.") + "\n" +
                         _("Left the desktop on the TV? Choose “{source}” in the TV's sources to go back.").format(
                             source=core.source_name()), wrap=True, max_width_chars=46, xalign=0)
        note.get_style_context().add_class("dim-label")
        grid.attach(note, 0, len(rows), 2, 1)
        grid.show_all()
        pop.add(grid)
        pop.connect("show", lambda *_a: self._fill_desk_screens())
        return pop

    def _desk_set(self, key, value):
        self.cfg[key] = value
        self._save()

    def _set_bring_back(self, on):
        self._desk_set("desk_bring_back", on)
        s = self.session
        if s and s.get("watch"):
            s["watch"].bring_back = on

    def _fill_desk_screens(self):
        c = self.desk_screen
        c.remove_all()
        if desk.session_kind() == "wayland":  # the desktop itself asks which screen or window
            c.append("ask", _("Asked when you start"))
            c.set_active_id("ask")
            c.set_sensitive(False)
            return
        c.set_sensitive(True)
        c.append("here", _("The one with this window"))
        display = Gdk.Display.get_default()
        for i in range(display.get_n_monitors()):
            mon = display.get_monitor(i)
            g, sc = mon.get_geometry(), mon.get_scale_factor()
            c.append(str(i), f"{mon.get_model() or _('Screen {n}').format(n=i + 1)} ({g.width * sc}×{g.height * sc})")
        if display.get_n_monitors() > 1:
            c.append("all", _("All screens"))
        if not c.set_active_id(str(self.cfg.get("desk_screen", "here"))):
            c.set_active_id("here")

    def _cast_area(self):
        """X11: (x, y, width, height) of the screen to cast, in real pixels; None for all screens."""
        display = Gdk.Display.get_default()
        choice = str(self.cfg.get("desk_screen", "here"))
        if choice == "all":
            return None
        mon = display.get_monitor(int(choice)) if choice.isdigit() and int(choice) < display.get_n_monitors() else None
        if mon is None:
            win = self.get_window()
            mon = (display.get_monitor_at_window(win) if win else None) or display.get_primary_monitor() \
                or display.get_monitor(0)
        if mon is None:
            return None
        g, sc = mon.get_geometry(), mon.get_scale_factor()
        return g.x * sc, g.y * sc, g.width * sc, g.height * sc

    def cast_desktop(self):
        if not self._ready_for("desktop", self.cast_desktop, ()):
            return
        need = desk.missing()
        if need:
            self.show_info(_("Casting the desktop needs a little more software. Install it with:"), WARNING,
                           selectable=core.install_hint(need))
            return
        if self.session:
            self._end_session(stop_tv=False)
        if self.pending_cast:
            old, self.pending_cast = self.pending_cast, None
            threading.Thread(target=old.stop, daemon=True).start()
        self.clear_info()
        self.gen += 1
        gen = self.gen
        wayland = desk.session_kind() == "wayland"
        self._set_mode("desktop")
        self._show_player(_("Your desktop"), _("Choose what to show in the window that opens…") if wayland
                          else _("Starting the screen capture…"))
        cast = desk.DesktopCast(height=int(self.cfg.get("desk_height", 1080)), fps=int(self.cfg.get("desk_fps", 30)),
                                sound=bool(self.cfg.get("desk_sound", True)),
                                area=None if wayland else self._cast_area(),
                                restore_token=self.cfg.get("portal_token"))
        cast.on_end = lambda msg: GLib.idle_add(self._cast_ended, cast, msg)
        self.pending_cast = cast
        cast.start(lambda err: GLib.idle_add(self._cast_started, gen, cast, err))

    def _cast_started(self, gen, cast, err):
        if cast is not self.pending_cast or gen != self.gen:
            threading.Thread(target=cast.stop, daemon=True).start()
            return False
        self.pending_cast = None
        if err:
            self.stack.set_visible_child_name("pick")
            self.show_info(_("Couldn't cast the desktop: {error}").format(error=err), ERROR)
            return False
        if cast.restore_token and cast.restore_token != self.cfg.get("portal_token"):
            self.cfg["portal_token"] = cast.restore_token  # next time the desktop shares without asking
            self._save()
        m = self.server.publish(live=cast.live, title=_("Desktop"))
        source = None
        try:
            source = core.TVSource(self.server, self.tv.host, m)
        except OSError:
            pass  # no way back from the TV's own menu; the rest works
        watch = core.ShareWatch(m, bool(self.cfg.get("desk_bring_back", False)))
        self._start_session("desktop", None, 0, media=m, title=_("Your desktop"), cast=cast, source=source,
                            watch=watch)
        self._update_live_row(self.session)
        if self.cfg.get("desk_sound", True) and not cast.sound:
            self.show_info(_("The PC's sound isn't going to the TV: there's no sound server to record it from."),
                           WARNING)
        return False

    def _follow_desktop(self, s, state, uri):
        """The shared desktop on the TV (core.ShareWatch decides): when the TV leaves it, it stays shared -
        the TV can come back by itself (OpusCast among its sources) or it's shown there again from here.
        Returns True when sharing ended (nobody watched for 30 minutes)."""
        event = s["watch"].update(state, uri)
        if event in ("left", "failed"):
            self._desktop_left(s, event)
        elif event == "back":
            self._drop_bar(s.get("away_bar"))
            s["away_bar"] = None
            self.tv_state = "PLAYING"
        elif event == "send":
            self._send_desktop(s)
        elif event == "idle":
            self._end_session(stop_tv=False)
            self.show_info(_("Nobody watched the desktop for 30 minutes, so OpusCast stopped sharing it."), INFO)
            return True
        if event:
            self._update_live_row(s)
            self._update_status()
        return False

    def _desktop_left(self, s, event, error=None):
        tv = self.tv.name if self.tv else _("The TV")
        if error is not None:
            text = _("The TV didn't accept that: {error}").format(error=error)
        elif event == "failed":
            text = _("The TV didn't show it again - is it on?")
        elif s.get("source"):
            text = _("{tv} left the desktop - it's still shared. To go back from the TV, choose “{source}” in its "
                     "sources or media player.").format(tv=tv, source=s["source"].name)
        else:
            text = _("{tv} left the desktop - it's still shared.").format(tv=tv)
        self._drop_bar(s.get("away_bar"))
        s["away_bar"] = self.show_info(text, WARNING if error is not None or event == "failed" else INFO,
                                       [(_("Show on the TV again"), self.show_desktop_again),
                                        (_("Stop sharing"), self.stop)])

    def show_desktop_again(self):
        """Send the shared desktop to the TV again (after the TV left it)."""
        s = self.session
        if not (s and s.get("watch") and self.tv) or s["watch"].sent_at is not None:
            return
        s["watch"].sent()
        self._drop_bar(s.get("away_bar"))
        s["away_bar"] = None
        self._send_desktop(s)
        self._update_live_row(s)
        self._update_status()

    def _send_desktop(self, s):
        tv, gen = self.tv, s["gen"]

        def work():
            try:
                core.play_media(tv, self.server, s["media"])
                return None
            except Exception as e:  # noqa: BLE001 - shown to the user
                return e

        def done(error):
            self.poller.wake.set()
            if error is None or self.session is not s or s["gen"] != gen:
                return
            s["watch"].send_failed()
            self._desktop_left(s, "failed", error)
            self._update_live_row(s)
            self._update_status()
        self.worker.submit(work, done=done)

    def _update_live_row(self, s):
        w = s.get("watch") if s else None
        away, sending = bool(w and w.away), bool(w and w.sent_at is not None)
        self.live_badge.set_visible(not away)
        self.live_again.set_visible(away)
        self.live_again.set_sensitive(not sending)
        if away and sending:
            text = _("Showing it on the TV again…")
        elif away and s.get("source"):
            text = _("On the TV: choose “{source}” in its sources to go back.").format(source=s["source"].name)
        elif away:
            text = _("Not on the TV now.")
        else:
            text = _("The TV shows the screen a second or two late.")
        self._set_text(self.live_note, text)
        if s and self.tv:
            self._set_text(self.placeholder_label, _("Still shared, but not on {tv} now").format(tv=self.tv.name)
                           if away else _("Playing on {tv}").format(tv=self.tv.name))

    def _cast_ended(self, cast, message):
        s = self.session
        if s and s["cast"] is cast:
            self._end_session(stop_tv=True)
            self.show_info(_("Desktop casting stopped: {error}").format(error=message), WARNING)
        return False

    # ------------------------------------------------------------ subtitles

    def _sub_name(self, entry):
        return _(entry["lang"]) if entry.get("lang") else shorten(entry["label"], 24)

    def _update_sub_button(self):
        s = self.session
        if not s or s["kind"] != "movie":
            return
        if s.get("sub_loading"):
            text = _("Subtitles: loading…")
        elif s["sub_tv_changed"]:
            text = _("Subtitles: set on the TV")
        elif s["sub_on"] and s["sub_entry"]:
            text = _("Subtitles: {name}").format(name=self._sub_name(s["sub_entry"]))
        elif s["subs"] is None:
            text = _("Subtitles")
        elif not any(e["ok"] for e in s["subs"]):
            text = _("Subtitles: none")
        else:
            text = _("Subtitles: off")
        self._set_text(self.sub_label, text)

    def _fill_sub_menu(self):
        for child in self.sub_menu.get_children():
            child.destroy()
        s = self.session
        title = Gtk.Label(xalign=0, margin_bottom=4)
        title.set_markup(f"<b>{GLib.markup_escape_text(_('Subtitles'))}</b>")
        self.sub_menu.pack_start(title, False, False, 0)
        if not s or s["kind"] != "movie":
            return
        if s["subs"] is None:
            row = Gtk.Box(spacing=8)
            spin = Gtk.Spinner(active=True)
            row.pack_start(spin, False, False, 0)
            row.pack_start(Gtk.Label(label=_("Looking for subtitles…")), False, False, 0)
            self.sub_menu.pack_start(row, False, False, 4)
        else:
            current = None if s["sub_tv_changed"] else (s["sub_entry"]["id"] if s["sub_entry"] and s["sub_on"] else "off")
            options = [(None, _("Off"))] + [(e, shorten(e["label"])) for e in s["subs"] if e["ok"]]
            for entry, label in options:
                b = Gtk.ModelButton(text=label, role=Gtk.ButtonRole.RADIO,
                                    active=(entry["id"] if entry else "off") == current)
                b.connect("clicked", lambda _b, e=entry: self._pick_subtitle(e))
                self.sub_menu.pack_start(b, False, False, 0)
            for e in s["subs"]:
                if not e["ok"]:
                    lbl = Gtk.Label(label=f"{shorten(e['label'], 40)} - {e['why']}", xalign=0, margin_start=8,
                                    wrap=True, max_width_chars=50)
                    lbl.get_style_context().add_class("dim-label")
                    self.sub_menu.pack_start(lbl, False, False, 2)
            if not s["subs"]:
                lbl = Gtk.Label(label=_("No subtitles found next to this video or inside it."), xalign=0,
                                wrap=True, max_width_chars=50)
                lbl.get_style_context().add_class("dim-label")
                self.sub_menu.pack_start(lbl, False, False, 4)
        self.sub_menu.pack_start(Gtk.Separator(), False, False, 6)
        pick = Gtk.ModelButton(text=_("Choose a subtitle file…"))
        pick.connect("clicked", lambda *_a: GLib.idle_add(self._choose_sub_file))
        self.sub_menu.pack_start(pick, False, False, 0)
        notes = []
        if s["sub_tv_changed"]:
            notes.append(_("Subtitles were changed with the TV remote. The TV doesn't tell the PC what's on, "
                           "so pick an option here to set them from the PC."))
        if s["caption_api"] is False:
            notes.append(_("This TV can't switch subtitles on command, so OpusCast restarts the video "
                           "with the subtitles you pick."))
        else:
            notes.append(_("Subtitles not showing? The TV's own subtitle setting may be off. Turn subtitles on "
                           "once with the TV remote - the PC can't change that setting."))
        if core.check_deps()[3]:
            notes.append(_("Subtitles built into videos need ffmpeg:") + " " + core.install_hint(["subs"]))
        for n in notes:
            lbl = Gtk.Label(label=n, xalign=0, wrap=True, max_width_chars=50, margin_top=6)
            lbl.get_style_context().add_class("dim-label")
            self.sub_menu.pack_start(lbl, False, False, 0)
        self.sub_menu.show_all()

    def _pick_subtitle(self, entry):
        self.sub_popover.popdown()
        s = self.session
        if not s or s["kind"] != "movie":
            return
        s["sub_tv_changed"] = False
        self._remember(s["path"], sub=entry["id"] if entry else None)
        if s["caption_api"] is False:  # this TV only takes subtitles with the video: restart with them
            if entry is None and not s["sub_entry"]:
                s["sub_on"] = False
                self._update_sub_button()
            elif entry is not None and s["sub_entry"] and s["sub_entry"]["id"] == entry["id"]:
                s["sub_on"] = True
                self._update_sub_button()
            else:
                self._restart_with(entry)
            return
        if entry is None or entry["id"] in s["paths"]:
            self._show_sub(s, entry)
            return
        s["sub_loading"] = True  # extract / convert it first (cached after the first time)
        self._update_sub_button()
        self._update_status()

        def work():
            try:
                data = core.prepare_subtitle(entry, s["path"])
            except core.TVError as e:
                GLib.idle_add(self._sub_failed, s["gen"], str(e))
                return
            GLib.idle_add(self._sub_prepared, s, entry, data)
        threading.Thread(target=work, daemon=True).start()

    def _sub_prepared(self, s, entry, data):
        if s is self.session:
            s["paths"][entry["id"]] = self.server.add_subtitle(s["media"], data)
            self._show_sub(s, entry)
        return False

    def _show_sub(self, s, entry):
        """Switch the TV to this subtitle (None: the empty file, i.e. off) without restarting the video."""
        s["sub_loading"] = True
        self._update_sub_button()
        self.last_caption_cmd = time.monotonic()
        path = s["paths"][entry["id"]] if entry else None
        self.worker.submit(core.show_subtitle, self.tv, self.server, s["media"], path,
                           done=lambda r, sess=s, e=entry: self._sub_shown(sess, e, r))

    def _sub_shown(self, s, entry, result):
        if s is not self.session:
            return
        s["sub_loading"] = False
        if result != "ok":  # not a Samsung after all: the TV needs the subtitle announced with the video
            s["caption_api"] = False
            self._restart_with(entry)
            return
        s["caption_api"], s["sub_on"] = True, entry is not None
        if entry:
            s["sub_entry"] = entry
        self._update_sub_button()
        self._update_status()

    def _restart_with(self, entry):
        """Start the video again from here with a different subtitle (the TV needs it announced up front)."""
        s = self.session
        gen = s["gen"]
        s["sub_loading"] = True
        self._update_sub_button()
        self._update_status()

        def work():
            try:
                data = core.prepare_subtitle(entry, s["path"]) if entry else None
            except core.TVError as e:
                GLib.idle_add(self._sub_failed, gen, str(e))
                return
            GLib.idle_add(self._sub_ready, gen, entry, data)
        threading.Thread(target=work, daemon=True).start()

    def _sub_ready(self, gen, entry, data):
        s = self.session
        if s and s["gen"] == gen:
            self._start_session("movie", s["path"], self.est_pos(), subtitle=(entry, data) if entry else None,
                                subs_on=entry is not None, subs=s["subs"])
        return False

    def _sub_failed(self, gen, message):
        s = self.session
        if s and s["gen"] == gen:
            s["sub_loading"] = False
            self._update_sub_button()
            self.show_info(_("Couldn't use those subtitles: {error}").format(error=message), WARNING)
        return False

    def _choose_sub_file(self):
        s = self.session
        if not s or s["kind"] != "movie":
            return False
        dlg = Gtk.FileChooserNative.new(_("Choose a subtitle file"), self, Gtk.FileChooserAction.OPEN,
                                        _("_Use"), _("_Cancel"))
        flt = Gtk.FileFilter()
        flt.set_name(_("Subtitles"))
        for ext in core.SUB_EXTS:
            flt.add_pattern("*" + ext)
            flt.add_pattern("*" + ext.upper())
        dlg.add_filter(flt)
        dlg.set_current_folder(os.path.dirname(s["path"]))
        response = dlg.run()
        path = dlg.get_filename()
        dlg.destroy()
        if response == Gtk.ResponseType.ACCEPT and path:
            self._use_sub_file(path)
        return False

    def _use_sub_file(self, path):
        s = self.session
        if not s:
            return
        entry = core.subtitle_file_entry(path)
        if s["subs"] is not None and not any(e["id"] == entry["id"] for e in s["subs"]):
            s["subs"].append(entry)
        self._pick_subtitle(entry)

    def _cycle_subtitles(self):
        """S key: off -> last/first subtitle -> off."""
        s = self.session
        if not s or s["kind"] != "movie" or not s["subs"]:
            return
        if s["sub_on"] and not s["sub_tv_changed"]:
            self._pick_subtitle(None)
            return
        usable = [e for e in s["subs"] if e["ok"]]
        entry = s["sub_entry"] or core.auto_subtitle(usable)
        if entry:
            self._pick_subtitle(entry)

    # ------------------------------------------------------------ seek bar & volume

    def _on_scale_press(self, *_args):
        self.dragging, self.drag_value = True, None
        return False

    def _on_scale_release(self, *_args):
        self.dragging = False
        if self.drag_value is not None:
            value, self.drag_value = self.drag_value, None
            self.seek_to(value)
        return False

    def _on_scale_change(self, _scale, _scroll, value):
        if not self.session:
            return True
        value = max(0.0, min(value, self.tv_dur or value))
        self._set_text(self.elapsed, fmt(value))
        if self.dragging:
            self.drag_value = value
            now = time.monotonic()
            if self.preview.path and now - self.last_scrub > 0.12:
                self.last_scrub = now
                self.preview.seek(value, accurate=False)
        else:
            if self.seek_timer:
                GLib.source_remove(self.seek_timer)
            self.seek_timer = GLib.timeout_add(350, self._debounced_seek, value)
        return False

    def _debounced_seek(self, value):
        self.seek_timer = None
        self.seek_to(value)
        return False

    def _on_volume(self, _button, value):
        if self.setting_vol or not self.tv:
            return
        self.vol_touched = time.monotonic()
        if self.vol_timer:
            GLib.source_remove(self.vol_timer)
        self.vol_timer = GLib.timeout_add(150, self._send_volume, int(round(value * 100)))

    def _send_volume(self, value):
        self.vol_timer = None
        self.worker.submit(self.tv.set_volume, value)
        return False

    # ------------------------------------------------------------ preview

    def _on_preview_toggled(self, switch, _pspec):
        on = switch.get_active()
        if on and not self.preview.ok:
            switch.set_active(False)
            missing = core.check_deps()[1] or ["gst-gtk"]
            self.show_info(_("“Show on PC” needs more GStreamer parts ({reason}). Install them with:").format(
                reason=self.preview.reason), WARNING, selectable=core.install_hint(missing))
            return
        self.cfg["preview"] = on
        self._save()
        if on and self.session:
            self._preview_load()
        elif not on:
            self.preview.unload()
        self._update_video_area()

    def _update_video_area(self):
        show = (bool(self.session) and self.session["kind"] in ("movie", "intro") and self.preview_switch.get_active()
                and self.preview.ok)
        self.video_box.set_visible(show)
        self.placeholder.set_visible(not show)
        if show:
            self.preview.widget.show()
            w, h = self.get_size()
            if h < 760 and not self.is_maximized():
                self.resize(max(w, 900), 820)

    def _preview_load(self):
        self._update_video_area()
        if self.session and self.session["kind"] in ("movie", "intro") and self.preview.ok:
            GLib.idle_add(self._preview_load_now, self.session["gen"])

    def _preview_load_now(self, gen):
        s = self.session
        if s and s["gen"] == gen and self.preview_switch.get_active():
            self.preview.load(s["path"], self.est_pos())
            self._sync_preview()
        return False

    def _sync_preview(self):
        p, s = self.preview, self.session
        if not (s and p.path == s["path"]):
            return
        want = self.tv_state == "PLAYING" and s["seen_playing"] and not self.hold and not self.dragging
        p.set_playing(want)
        if self.dragging:
            return
        here = p.position()
        if here is None:
            return
        target = self.est_pos()
        if abs(here - target) > (1.5 if want else 0.3):
            p.seek(target)

    def _swap_preview_widget(self, old, new):
        self.video_box.remove(old)
        self.video_box.add(new)
        new.show()

    def _on_preview_error(self, message):
        missing = core.check_deps()[1]
        if not missing and ("plug-in" in message or "plugin" in message.lower()):
            missing = ["gst-libav", "gst-good"]
        self.preview_switch.set_active(False)
        self.show_info(_("The PC preview can't play this video ({error}). The TV isn't affected.").format(
            error=message), WARNING, selectable=core.install_hint(missing) if missing else None)

    # ------------------------------------------------------------ misc

    def _on_intro_toggled(self, switch, _pspec):
        on = switch.get_active()
        if on:
            ok, reason = intro.available()
            if not ok:
                switch.set_active(False)
                self.show_info(_("The Skynet intro {reason}. Install with:").format(reason=reason), WARNING,
                               selectable=core.install_hint(["intro"]))
                return
            if not intro.cached_path():  # render it now so the first play starts right away
                threading.Thread(target=lambda: self._quietly(intro.ensure_intro), daemon=True).start()
        self.cfg["intro"] = on
        self._save()

    @staticmethod
    def _quietly(fn, *args, **kw):
        try:
            fn(*args, **kw)
        except Exception:  # noqa: BLE001
            pass

    def _on_worker_error(self, error):
        s = self.session
        if s and s.get("sub_loading"):
            s["sub_loading"] = False
            self._update_sub_button()
        if s and s["kind"] == "photo" and s["index"]:
            self.show_info(_("The TV didn't take this photo: {error}").format(error=error), WARNING)
        elif s and not s["seen_playing"]:
            self._end_session(stop_tv=False)
            self.show_info(_("Couldn't start it on the TV: {error}").format(error=error), ERROR)
        else:
            self.show_info(_("The TV didn't accept that: {error}").format(error=error), WARNING)
        return False

    def _on_key(self, _w, ev):
        ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
        shift = ev.state & Gdk.ModifierType.SHIFT_MASK
        k = ev.keyval
        if ctrl and k in (Gdk.KEY_o, Gdk.KEY_O):
            self.choose_file()
            return True
        if ctrl and k in (Gdk.KEY_d, Gdk.KEY_D):
            self.cast_desktop()
            return True
        if (not self.session or ctrl or self.dev_button.get_active() or self.sub_button.get_active()
                or self.tracks_button.get_active()):
            return False
        kind = self.session["kind"]
        if kind in ("music", "photo") and k in (Gdk.KEY_Page_Up, Gdk.KEY_Page_Down):
            self.step(1 if k == Gdk.KEY_Page_Down else -1)
            return True
        if kind == "photo" and k in (Gdk.KEY_Left, Gdk.KEY_Right):
            self.step(1 if k == Gdk.KEY_Right else -1)
            return True
        if kind == "desktop":
            if k == Gdk.KEY_space and self.session.get("watch") and self.session["watch"].away:
                self.show_desktop_again()
                return True
            if k in (Gdk.KEY_Left, Gdk.KEY_Right, Gdk.KEY_space):
                return False
        if kind != "movie" and k in (Gdk.KEY_p, Gdk.KEY_P, Gdk.KEY_s, Gdk.KEY_S):
            return False
        if k == Gdk.KEY_space:
            self.toggle_play()
        elif k in (Gdk.KEY_Left, Gdk.KEY_Right):
            self.skip((30 if shift else 10) * (1 if k == Gdk.KEY_Right else -1))
        elif k in (Gdk.KEY_Up, Gdk.KEY_Down):
            step = 0.05 if k == Gdk.KEY_Up else -0.05
            self.volume.set_value(min(1.0, max(0.0, self.volume.get_value() + step)))
        elif k in (Gdk.KEY_p, Gdk.KEY_P):
            self.preview_switch.set_active(not self.preview_switch.get_active())
        elif k in (Gdk.KEY_s, Gdk.KEY_S):
            self._cycle_subtitles()
        else:
            return False
        return True

    def _save(self):
        try:
            core.save_config(self.cfg)
        except OSError:
            pass

    def _on_close(self, *_args):
        s, tv = self.session, self.tv
        sids = dict(self.event_sids)

        def shutdown():
            if s:
                self._quietly(tv.stop, timeout=2.5)
            for service, sid in sids.items():
                tv.unsubscribe(service, sid)
        cast = s["cast"] if s else self.pending_cast
        if s:
            self._end_session(stop_tv=False)
        if cast:
            cast.stop()
        if tv:
            t = threading.Thread(target=shutdown, daemon=True)
            t.start()
            t.join(4)
        self.preview.unload()
        self._save()
        self.server.close()
        return False


class OpusCastApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=core.APP_ID, flags=Gio.ApplicationFlags.HANDLES_OPEN)
        self.win = None

    def do_activate(self):
        if not self.win:
            try:
                self.win = OpusCastWindow(self)
            except core.TVError as e:
                dlg = Gtk.MessageDialog(message_type=ERROR, buttons=Gtk.ButtonsType.CLOSE,
                                        text=_("{app} can't start").format(app=core.APP_NAME), secondary_text=str(e))
                dlg.run()
                dlg.destroy()
                return
        self.win.present()

    def do_open(self, files, _n_files, _hint):
        self.do_activate()
        paths = [f.get_path() for f in files if f.get_path()]
        if paths and self.win:
            self.win.open_paths(paths)


def main():
    GLib.set_prgname("opuscast")
    GLib.set_application_name(core.APP_NAME)
    Gtk.Window.set_default_icon_name(core.APP_ID)
    sys.exit(OpusCastApp().run(sys.argv))


if __name__ == "__main__":
    main()
