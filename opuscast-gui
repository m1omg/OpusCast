            b = Gtk.Box(spacing=8, tooltip_text=tip)
            sw = Gtk.Switch(active=bool(active), valign=Gtk.Align.CENTER)
            sw.connect("notify::active", callback)
            b.pack_start(sw, False, False, 0)
            b.pack_start(Gtk.Label(label=text), False, False, 0)
            bar.pack_start(b, False, False, 0)
            return sw

        self.preview_switch = toggle(_("Show on PC"), _("Show a muted copy of the video here, in step with the TV (P)"),
                                     self.cfg.get("preview") and self.preview.ok, self._on_preview_toggled)
